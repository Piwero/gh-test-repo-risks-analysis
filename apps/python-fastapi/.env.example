# Copy to .env and adjust. All settings use the APP_ prefix.
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DATABASE_URL=sqlite:///./data/app.db
APP_UPLOAD_DIR=./data/uploads
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_CORS_ORIGINS=["http://localhost:3000"]
APP_DEBUG=false
APP_PAYMENT_API_URL=https://api.paybridge.io/v2
